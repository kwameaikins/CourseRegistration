              "schema": {
                "$ref": "#/components/schemas/AdminBootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminBootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
